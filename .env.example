# Channel Analyzer Bot — owner configuration
# Copying this file manually is optional: docker compose uses safe defaults.

# Public Control Center port
CONTROL_CENTER_PORT=8080

# PostgreSQL. Change only when the service is exposed outside Docker.
POSTGRES_DB=osint
POSTGRES_USER=channel_analyzer
POSTGRES_PASSWORD=replace-with-a-long-random-password

# External owner gate
OWNER_GATE_PASSWORD=replace-with-a-strong-owner-password

# Product mode
APP_MODE=setup
LOG_LEVEL=INFO

# Telegram and AI credentials are entered in Control Center after startup.
# Do not commit real secrets into this file.
